# ==========================================
# KrishiGuard AI — Environment Configuration
# ==========================================

# Persistent Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.7mygy2n.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=krishiguard

# Redis (Sessions, Caching, Queues, Rate Limiting)
REDIS_URL=redis://localhost:6379/0

# Gemini AI (Backend only - never expose to browser)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Weather Integration (Open-Meteo)
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_SECONDS=900

# Security & Sessions
SESSION_SECRET=change_this_to_a_random_32_byte_secret_key
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_SECRET=change_this_to_another_random_secret_token

# CORS & Frontend Origins
FRONTEND_ORIGIN=http://localhost:5173

# Storage (Local secure directory or cloud bucket)
STORAGE_DIR=./uploads/crop_images
ASSESSMENT_MAX_UPLOAD_BYTES=5242880
ASSESSMENT_JOB_TIMEOUT_SECONDS=180

# Atomic Rate Limiting (Redis Lua)
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_GENERAL_MAX_REQUESTS=120
RATE_LIMIT_GENERAL_WINDOW_SECONDS=60
RATE_LIMIT_ASSESSMENT_MAX=10
RATE_LIMIT_ASSESSMENT_WINDOW_SECONDS=3600
